\tikzset{
  pics/field out/.style = {code={
    \draw (0,0) circle[radius=0.1];
    \fill (0,0) circle[radius=0.025];
    \coordinate (-center) at (0,0);
  }},
  pics/field in/.style = {code={
    \draw (0,0) circle[radius=0.1];
    \draw (45:0.1) -- (225:0.1) (135:0.1) -- (315:0.1);
    \coordinate (-center) at (0,0);
  }},
}


% ---------------------------------------------------------------------
% Bands along a path
% ---------------------------------------------------------------------
% The decoration `physketch band' puts a band on one side of a path.
% A straight segment gets one band of exactly its length, cut at its ends
% along the bisector of the corner with the neighbouring segments (like a
% mitre join), so the band of a polyline is continuous.  A curved segment
% is walked in steps that continue over the joins of the curve segments.
% The contents of the band are given by \physketch@band@kind (hatch or
% shade) and \physketch@band@arg (the hatch distance or a shading);
% \physketch@s is 1 for the left and -1 for the right side.
\pgfdeclaredecoration{physketch band}{segment}{
  \state{segment}[
      physketch prepare, width=\physketch@band@step, next state=segment]{%
    \pgfinterruptpath
      \pgfscope
        \physketch@band@draw
      \endpgfscope
    \endpgfinterruptpath
  }
  \state{final}{}
}
\newif\ifphysketch@curve
\newif\ifphysketch@tick
% the width of a state is computed while its options are read
\pgfkeys{/pgf/decoration automaton/physketch prepare/.code=\physketch@band@prepare}
\def\physketch@band@prepare{%
  \ifx\pgfdecorationcurrentinputsegment\pgfdecorationinputsegmentcurveto
    \global\physketch@curvetrue
    % \physketch@togo: distance to the next stroke, over the whole path
    \ifdim\physketch@togo<0.01pt
      \global\physketch@ticktrue
      \pgfmathsetlengthmacro\physketch@tmp{\physketch@band@curvestep}%
      \global\let\physketch@togo\physketch@tmp
    \else
      \global\physketch@tickfalse
    \fi
    \pgfmathsetlengthmacro\physketch@band@step{min(\physketch@togo,
      \pgfdecoratedinputsegmentremainingdistance)}%
    \ifdim\physketch@band@step<0.01pt
      \def\physketch@band@step{0.01pt}%
    \fi
    \pgfmathsetlengthmacro\physketch@tmp{\physketch@togo-\physketch@band@step}%
    \global\let\physketch@togo\physketch@tmp
    \physketch@band@turns
  \else
    \global\physketch@curvefalse
    \edef\physketch@band@step{\the\pgfdecoratedinputsegmentremainingdistance}%
    \physketch@band@turns
    \pgfmathsetlengthmacro\physketch@tmp{\physketch@band@curvestep}%
    \global\let\physketch@togo\physketch@tmp
  \fi
}
% the turn into this segment (\physketch@turnin) and out of it
% (\physketch@turnout), in degrees, normalised and limited
\def\physketch@band@turns{%
  \let\physketch@turnin\physketch@prevturn
  \pgfmathparse{\pgfdecoratedremainingdistance
    - \pgfdecoratedinputsegmentremainingdistance < 0.01 ? 0 :
    \pgfdecoratedangletonextinputsegment}%
  \pgfmathsetmacro\physketch@turnout{max(-140, min(140,
    \pgfmathresult - 360*round(\pgfmathresult/360)))}%
  \global\let\physketch@prevturn\physketch@turnout
}
\def\physketch@band@draw{%
  \pgfmathsetlengthmacro\physketch@W{\physketch@s*(\physketch@band@width)}%
  \ifphysketch@curve
    \csname physketch@band@curve@\physketch@band@kind\endcsname
  \else
    \edef\physketch@L{\the\pgfdecoratedinputsegmentremainingdistance}%
    % ends of the band at its outer edge, cut along the bisectors
    \pgfmathsetlengthmacro\physketch@xa{\physketch@W*tan(\physketch@turnin/2)}%
    \pgfmathsetlengthmacro\physketch@xb
      {\physketch@L-\physketch@W*tan(\physketch@turnout/2)}%
    \pgfmathsetlengthmacro\physketch@xmin{min(0pt,\physketch@xa)}%
    \pgfmathsetlengthmacro\physketch@xmax{max(\physketch@L,\physketch@xb)}%
    \csname physketch@band@line@\physketch@band@kind\endcsname
  \fi
}

% #1 = side (right or left), #2 = width, #3 = kind, #4 = argument
\tikzset{
  physketch/band/.code n args = {4}{%
    \csname physketch@side@#1\endcsname
    \def\physketch@band@width{#2}%
    \def\physketch@band@kind{#3}%
    \edef\physketch@band@arg{#4}%
    % the distance of the hatching: the argument of the band, if given
    \ifx\physketch@band@arg\@empty
      \edef\physketch@band@hatchdistance{\pgfkeysvalueof{/physketch/hatch distance}}%
    \else
      \let\physketch@band@hatchdistance\physketch@band@arg
    \fi
    % the step on curved segments
    \ifx\physketch@band@kind\physketch@kind@hatch
      \let\physketch@band@curvestep\physketch@band@hatchdistance
    \else
      \def\physketch@band@curvestep{0.4mm}%
    \fi
    \gdef\physketch@togo{0pt}%
    \gdef\physketch@prevturn{0}%
    \tikzset{decorate, decoration={physketch band}}%
  },
}
\def\physketch@side@right{\def\physketch@s{-1}}
\def\physketch@side@left{\def\physketch@s{1}}

% the band of a straight segment
\def\physketch@band@polygon{%
  \pgfpathmoveto{\pgfpointorigin}%
  \pgfpathlineto{\pgfqpoint{\physketch@L}{0pt}}%
  \pgfpathlineto{\pgfqpoint{\physketch@xb}{\physketch@W}}%
  \pgfpathlineto{\pgfqpoint{\physketch@xa}{\physketch@W}}%
  \pgfpathclose
}
% straight segments
\def\physketch@band@line@shade{%
  \physketch@band@polygon\pgfusepath{clip}%
  \pgfmathsetlengthmacro\physketch@len{\physketch@xmax-\physketch@xmin}%
  \physketch@band@shading{\physketch@xmin}{\physketch@len}%
}
\def\physketch@band@line@hatch{%
  \physketch@band@polygon\pgfusepath{clip}%
  \physketch@band@hatchsetup
  \pgfmathsetlength\dimen@{\physketch@xmin-abs(\physketch@dx)}%
  \pgfmathsetlength\dimen@ii{\physketch@xmax+abs(\physketch@dx)}%
  \loop
    \pgfpathmoveto{\pgfqpoint{\dimen@}{0pt}}%
    \pgfpathlineto{\pgfpoint{\dimen@+\physketch@dx}{\physketch@W}}%
    \advance\dimen@ by \physketch@step\relax
  \ifdim\dimen@<\dimen@ii
  \repeat
  \pgfusepath{stroke}%
}
% curved segments: one piece per step
\def\physketch@kind@hatch{hatch}

\def\physketch@band@curve@shade{%
  \physketch@band@shading{0pt}{1.3*\physketch@band@step}%
}
\def\physketch@band@curve@hatch{%
  \ifphysketch@tick
    \physketch@band@hatchsetup
    % skip strokes that would stick out beyond the ends of the path
    \pgfmathparse{((\physketch@dx < 0) &&
        (\pgfdecoratedcompleteddistance < -\physketch@dx))
      || ((\physketch@dx > 0) &&
        (\pgfdecoratedremainingdistance < \physketch@dx)) ? 0 : 1}%
    \ifdim\pgfmathresult pt>0.5pt
      \pgfpathmoveto{\pgfpointorigin}%
      \pgfpathlineto{\pgfpoint{\physketch@dx}{\physketch@W}}%
      \pgfusepath{stroke}%
    \fi
  \fi
}
\def\physketch@band@hatchsetup{%
  \pgfsetlinewidth{\pgfkeysvalueof{/physketch/hatch line width}}%
  \pgfmathsetlengthmacro\physketch@dx
    {\physketch@W*cot(\pgfkeysvalueof{/physketch/hatch angle})}%
  \pgfmathsetlengthmacro\physketch@step{\physketch@band@hatchdistance}%
}
% the vertical shading \physketch@band@arg stretched over the band from
% x = #1 over the length #2
\def\physketch@band@shading#1#2{%
  \pgfmathsetlengthmacro\physketch@x{#1}%
  \pgfmathsetlengthmacro\physketch@len{#2}%
  \pgftransformshift{\pgfpoint{\physketch@x+\physketch@len/2}{\physketch@W/2}}%
  \pgfmathsetmacro\physketch@xs{\physketch@len/100bp}%
  \pgfmathsetmacro\physketch@ys{\physketch@W/100bp}%
  \pgftransformxscale{\physketch@xs}%
  \pgftransformyscale{\physketch@ys}%
  \pgflowlevelsynccm
  \pgfuseshading{\physketch@band@arg}%
}

% ---------------------------------------------------------------------
% Fixed surfaces
% ---------------------------------------------------------------------
% \draw[surface] hatches the right side of the path, \draw[surface'] the
% left side; \fill[surface] fills an area with hatching.
\newif\ifphysketch@isfill
\def\physketch@checkfill{%
  \begingroup
    \tikz@mode
    \iftikz@mode@fill\aftergroup\physketch@isfilltrue
    \else\aftergroup\physketch@isfillfalse\fi
  \endgroup
}
\tikzset{
  physketch/surface/.code = {%
    \physketch@checkfill
    \ifphysketch@isfill
      \tikzset{pattern={Lines[angle=\pgfkeysvalueof{/physketch/hatch angle},
        distance=\pgfkeysvalueof{/physketch/hatch distance},
        line width=\pgfkeysvalueof{/physketch/hatch line width}]}}%
    \else
      \tikzset{thick, preaction={physketch/band={#1}%
        {\pgfkeysvalueof{/physketch/hatch depth}}{hatch}{}}}%
    \fi
  },
  surface/.style  = {physketch/surface=right},
  surface'/.style = {physketch/surface=left},
}

% ---------------------------------------------------------------------
% Distances
% ---------------------------------------------------------------------
\tikzset{
  physketch/dist line/.style      = {ultra thin, >={Latex[length=1.3mm, width=0.9mm]}},
  physketch/dist extension/.style = {ultra thin},
  physketch/dist label/.style     = {},
  physketch/angle arc/.style      = {},
  physketch/angle label/.style    = {},
}

% \dist[<options>] (A) -- (B);
% The label is given by the option l=<text> (on the outer side of the
% dimension line) or l_=<text> (on the inner side), at the position pos.
\NewDocumentCommand\dist{O{}}{\physketch@dist@read{#1}}
\def\physketch@dist@read#1#2--#3;{%
  \begingroup
    \def\physketch@dist@label{}%
    \begin{scope}[/physketch/dist/.cd,#1]
      \physketch@dist{#2}{#3}%
    \end{scope}%
  \endgroup
}
\def\physketch@distkey#1{\pgfkeysvalueof{/physketch/dist/#1}}
\def\physketch@dist#1#2{%
  \path #1 coordinate (physketch@A) #2 coordinate (physketch@B);
  \pgfmathanglebetweenpoints
    {\pgfpointanchor{physketch@A}{center}}%
    {\pgfpointanchor{physketch@B}{center}}%
  \let\physketch@ang\pgfmathresult
  \pgfmathsetlengthmacro\physketch@off{\physketch@distkey{offset}}%
  \edef\physketch@dir{\physketch@distkey{direction}}%
  \ifx\physketch@dir\@empty
    \pgfmathsetmacro\physketch@phi{\physketch@ang+90}%
  \else
    \pgfmathsetmacro\physketch@phi{\physketch@dir}%
  \fi
  \pgfmathsetmacro\physketch@sgn{\physketch@off<0 ? -1 : 1}%
  \pgfmathsetlengthmacro\physketch@from{\physketch@sgn*(\physketch@distkey{gap})}%
  \pgfmathsetlengthmacro\physketch@to
    {\physketch@off+\physketch@sgn*(\physketch@distkey{overshoot})}%
  \pgfmathsetmacro\physketch@anchor
    {mod(\physketch@phi + (\physketch@sgn<0 ? 360 : 180), 360)}%
  \foreach \physketch@P in {physketch@A,physketch@B}
    \draw[physketch/dist extension]
      ($(\physketch@P)+(\physketch@phi:\physketch@from)$) --
      ($(\physketch@P)+(\physketch@phi:\physketch@to)$);
  \coordinate (physketch@A1) at ($(physketch@A)+(\physketch@phi:\physketch@off)$);
  \coordinate (physketch@B1) at ($(physketch@B)+(\physketch@phi:\physketch@off)$);
  \ifphysketch@dim@outside
    \pgfmathanglebetweenpoints
      {\pgfpointanchor{physketch@A1}{center}}%
      {\pgfpointanchor{physketch@B1}{center}}%
    \let\physketch@psi\pgfmathresult
    \pgfmathsetlengthmacro\physketch@len{\physketch@distkey{outside length}}%
    \draw[physketch/dist line, ->]
      ($(physketch@A1)+(\physketch@psi:-\physketch@len)$) -- (physketch@A1);
    \draw[physketch/dist line, ->]
      ($(physketch@B1)+(\physketch@psi:\physketch@len)$) -- (physketch@B1);
  \else
    \draw[physketch/dist line, <->] (physketch@A1) -- (physketch@B1);
  \fi
  \ifx\physketch@dist@label\@empty\else
    \ifphysketch@dist@inner
      \pgfmathsetmacro\physketch@anchor{mod(\physketch@anchor+180,360)}%
    \fi
    \path ($(physketch@A1)!\physketch@distkey{pos}!(physketch@B1)$)
      node[anchor=\physketch@anchor, physketch/dist label] {\physketch@dist@label};
  \fi
}

% \angledist[<options>] (A) -- (O) -- (B);
% An arc around the vertex O from the ray OA to the ray OB, counterclockwise
% (as in the TikZ library `angles').  The label is given by l=<text>
% (outside the arc) or l_=<text> (inside the arc), at the position pos
% along the arc.  By default the label is put `label distance' away from
% the arc and touches it with its side, so it never covers the arc
% whatever the radius; an explicit `label radius' puts the centre of the
% label at that distance from the vertex instead.
\NewDocumentCommand\angledist{O{}}{\physketch@angle@read{#1}}
\def\physketch@angle@read#1#2--#3--#4;{%
  \begingroup
    \def\physketch@angle@label{}%
    \begin{scope}[/physketch/angle/.cd,#1]
      \path #2 coordinate (physketch@A) #3 coordinate (physketch@O)
        #4 coordinate (physketch@B);
      \pgfmathanglebetweenpoints{\pgfpointanchor{physketch@O}{center}}%
        {\pgfpointanchor{physketch@A}{center}}%
      \let\physketch@from\pgfmathresult
      \pgfmathanglebetweenpoints{\pgfpointanchor{physketch@O}{center}}%
        {\pgfpointanchor{physketch@B}{center}}%
      \pgfmathsetmacro\physketch@to{\pgfmathresult
        + (\pgfmathresult < \physketch@from ? 360 : 0)}%
      \pgfmathsetlengthmacro\physketch@r{\pgfkeysvalueof{/physketch/angle/radius}}%
      \pgfmathsetmacro\physketch@mid{\physketch@from
        + \pgfkeysvalueof{/physketch/angle/pos}*(\physketch@to-\physketch@from)}%
      % options like `double' work on paths only, so repeat them here
      \draw[physketch/angle arc, /physketch/angle/.cd, #1]
        (physketch@O) ++(\physketch@from:\physketch@r)
        arc[start angle=\physketch@from, end angle=\physketch@to,
          radius=\physketch@r];
      \ifx\physketch@angle@label\@empty\else
        \edef\physketch@lr{\pgfkeysvalueof{/physketch/angle/label radius}}%
        \ifx\physketch@lr\@empty
          \ifphysketch@angle@inner
            \pgfmathsetlengthmacro\physketch@lr
              {\physketch@r-\pgfkeysvalueof{/physketch/angle/label distance}}%
            \pgfmathsetmacro\physketch@anchor{mod(\physketch@mid,360)}%
          \else
            \pgfmathsetlengthmacro\physketch@lr
              {\physketch@r+\pgfkeysvalueof{/physketch/angle/label distance}}%
            \pgfmathsetmacro\physketch@anchor{mod(\physketch@mid+180,360)}%
          \fi
          \path (physketch@O) ++(\physketch@mid:\physketch@lr)
            node[anchor=\physketch@anchor, inner sep=1pt,
              physketch/angle label] {\physketch@angle@label};
        \else
          \pgfmathsetlengthmacro\physketch@lr{\physketch@lr}%
          \path (physketch@O) ++(\physketch@mid:\physketch@lr)
            node[physketch/angle label] {\physketch@angle@label};
        \fi
      \fi
    \end{scope}%
  \endgroup
}

\endinput
