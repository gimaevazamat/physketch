% ---------------------------------------------------------------------
% House style, applied to every picture
% ---------------------------------------------------------------------
\tikzset{
  physketch/.style = {>={Latex[length=1.6mm, width=1.1mm]}},
  every picture/.append style = {physketch},
}

% ---------------------------------------------------------------------
% Basic styles
% ---------------------------------------------------------------------
\tikzset{
  % materials
  physketch/material/.style 2 args = {fill=#1, fill opacity=#2, text opacity=1},
  water/.style = {physketch/material={water}{0.5}},
  ice/.style   = {physketch/material={ice}{0.7}},
  oil/.style   = {physketch/material={oil}{0.7}},
  gas/.style   = {physketch/material={gas}{0.5}},
  glass/.style = {physketch/material={glass}{0.5}},
  % arrows in the middle of a path
  mid arrow/.style = {postaction={decorate, decoration={markings,
    mark=at position #1 with {\arrow{>}}}}},
  mid arrow/.default = 0.6,
  mid arrow'/.style = {postaction={decorate, decoration={markings,
    mark=at position #1 with {\arrowreversed{>}}}}},
  mid arrow'/.default = 0.4,
  % a force: a dot at the point of application and an arrow at the end;
  % the value is the radius of the dot
  force/.style = {thick, ->, postaction={decorate, decoration={markings,
    mark=at position 0 with {\fill (0,0) circle[radius=#1];}}}},
  force/.default = 0.05cm,
  % local versions of the hatching settings
  hatch distance/.code = \pgfkeyssetvalue{/physketch/hatch distance}{#1},
  hatch depth/.code    = \pgfkeyssetvalue{/physketch/hatch depth}{#1},
  hatch angle/.code    = \pgfkeyssetvalue{/physketch/hatch angle}{#1},
}

% ---------------------------------------------------------------------
% Rotation arrows
% ---------------------------------------------------------------------
% \rotation[radius=3mm, tilt=1, start=45, end=315, cw, l=$\omega$]{(x,y)}
% An arc with an arrow around (x,y), counterclockwise from `start' to `end'
% (cw: the arrow points the other way).  tilt < 1 squeezes the arc
% vertically: a rotation about a vertical axis seen from the side.
\newif\ifphysketch@rot@cw
\pgfqkeys{/physketch/rotation}{
  radius/.initial      = 3mm,
  tilt/.initial        = 1,
  start/.initial       = 45,
  end/.initial         = 315,
  label angle/.initial = 0,
  cw/.code             = \physketch@rot@cwtrue,
  ccw/.code            = \physketch@rot@cwfalse,
  l/.code              = \def\physketch@rot@label{#1},
  .unknown/.code       = \physketch@unknown{#1},
}
\def\physketch@rotkey#1{\pgfkeysvalueof{/physketch/rotation/#1}}
\NewDocumentCommand\rotation{O{}m}{%
  \begingroup
    \def\physketch@opts{}%
    \def\physketch@rot@label{}%
    \physketch@rot@cwfalse
    \pgfqkeys{/physketch/rotation}{#1}%
    \pgfmathsetlengthmacro\physketch@rx{\physketch@rotkey{radius}}%
    \pgfmathsetlengthmacro\physketch@ry{\physketch@rotkey{tilt}*\physketch@rx}%
    \ifphysketch@rot@cw\def\physketch@tips{<-}\else\def\physketch@tips{->}\fi
    \edef\physketch@do{\noexpand\draw[\physketch@tips,
      \unexpanded\expandafter{\physketch@opts}] \unexpanded{#2}
      ++(\physketch@rotkey{start}:\physketch@rx\space and \physketch@ry)
      arc[start angle=\physketch@rotkey{start}, end angle=\physketch@rotkey{end},
        x radius=\physketch@rx, y radius=\physketch@ry];}%
    \physketch@do
    \ifx\physketch@rot@label\@empty\else
      \pgfmathsetmacro\physketch@anchor{mod(\physketch@rotkey{label angle}+180,360)}%
      \path #2 ++(\physketch@rotkey{label angle}:\physketch@rx\space and \physketch@ry)
        node[anchor=\physketch@anchor, inner sep=2pt] {\physketch@rot@label};
    \fi
  \endgroup
}

% ---------------------------------------------------------------------
% Vectors perpendicular to the drawing plane
