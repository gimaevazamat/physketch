% ---------------------------------------------------------------------
% Basic styles
% ---------------------------------------------------------------------
\tikzset{
  % materials
  physketch/material/.style 2 args = {fill=#1, fill opacity=#2, text opacity=1},
  water/.style = {physketch/material={water}{0.5}},
  ice/.style   = {physketch/material={ice}{0.7}},
  oil/.style   = {physketch/material={oil}{0.7}},
  gas/.style   = {physketch/material={gas}{0.5}},
  snow/.style  = {preaction={physketch/material={snow}{0.7}}, bw snow},
  glass/.style = {physketch/material={glass}{0.5}},
  % arrows in the middle of a path
  mid arrow/.style = {postaction={decorate, decoration={markings,
    mark=at position #1 with {\arrow{>}}}}},
  mid arrow/.default = 0.6,
  mid arrow'/.style = {postaction={decorate, decoration={markings,
    mark=at position #1 with {\arrowreversed{>}}}}},
  mid arrow'/.default = 0.4,
  % a force: a dot at the point of application and an arrow at the end;
  % the value is the radius of the dot
  force/.style = {thick, ->, postaction={decorate, decoration={markings,
    mark=at position 0 with {\fill (0,0) circle[radius=#1];}}}},
  force/.default = 0.05cm,
  % local versions of the hatching settings
  hatch distance/.code = \pgfkeyssetvalue{/physketch/hatch distance}{#1},
  hatch depth/.code    = \pgfkeyssetvalue{/physketch/hatch depth}{#1},
  hatch angle/.code    = \pgfkeyssetvalue{/physketch/hatch angle}{#1},
}

% ---------------------------------------------------------------------
% Materials for black-and-white printing
% ---------------------------------------------------------------------
% Patterns of irregularly scattered marks.  The coordinates (in mm) were
% generated once (a periodic Poisson-disk sample), so a tile repeats
% seamlessly and the output never changes between runs.
%   dashes: x1/y/x2 -- a horizontal dash;   dots: x/y -- a mark centre
\def\physketch@dashes#1{%
  \@for\physketch@item:=#1\do{\expandafter\physketch@dash\physketch@item\@nil}%
  \pgfusepath{stroke}}
\def\physketch@dash#1/#2/#3\@nil{%
  \pgfpathmoveto{\pgfpoint{#1mm}{#2mm}}\pgfpathlineto{\pgfpoint{#3mm}{#2mm}}}
\def\physketch@dots#1#2#3{% list, radius, stroke or fill
  \def\physketch@r{#2}%
  \@for\physketch@item:=#1\do{\expandafter\physketch@dot\physketch@item\@nil}%
  \pgfusepath{#3}}
\def\physketch@dot#1/#2\@nil{%
  \pgfpathcircle{\pgfpoint{#1mm}{#2mm}}{\physketch@r mm}}
% \physketch@pattern{<name>}{<tile size, mm>}{<code>}
\def\physketch@pattern#1#2#3{%
  \pgfdeclarepattern{name=physketch@#1, type=uncolored,
    bottom left={\pgfpoint{0mm}{0mm}}, top right={\pgfpoint{#2mm}{#2mm}},
    tile size={\pgfpoint{#2mm}{#2mm}}, code={#3}}}

