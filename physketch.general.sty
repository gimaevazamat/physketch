% ---------------------------------------------------------------------
% Settings
% ---------------------------------------------------------------------
\newcommand\physketchset[1]{\pgfqkeys{/physketch}{#1}}

\pgfqkeys{/physketch}{
  gap/.initial                 = 0.25mm,
  hatch distance/.initial      = 0.74mm,
  hatch depth/.initial         = 1mm,
  hatch angle/.initial         = 45,
  hatch line width/.initial    = 0.4pt,
  dist/offset/.initial          = 5mm,
  dist/overshoot/.initial       = 1mm,
  dist/gap/.initial             = 0pt,
  dist/direction/.initial       = {},
  dist/outside length/.initial  = 2mm,
  dist/pos/.initial             = 0.5,
  dist/l/.code                  =
    \def\physketch@dist@label{#1}\physketch@dist@innerfalse,
  dist/l_/.code                 =
    \def\physketch@dist@label{#1}\physketch@dist@innertrue,
  dist/outside/.code            = \physketch@dim@outsidetrue,
  dist/inside/.code             = \physketch@dim@outsidefalse,
  dist/label style/.code        =
    \tikzset{physketch/dist label/.append style={#1}},
  dist/line style/.code         =
    \tikzset{physketch/dist line/.append style={#1}},
  dist/.search also             = {/tikz},
  angle/radius/.initial              = 7.5mm,
  angle/label radius/.initial        = {},
  angle/label distance/.initial      = 1mm,
  angle/pos/.initial                 = 0.5,
  angle/l/.code                      =
    \def\physketch@angle@label{#1}\physketch@angle@innerfalse,
  angle/l_/.code                     =
    \def\physketch@angle@label{#1}\physketch@angle@innertrue,
  angle/label style/.code            =
    \tikzset{physketch/angle label/.append style={#1}},
  angle/.search also                 = {/tikz},
}
\newif\ifphysketch@dim@outside
\newif\ifphysketch@dist@inner
\newif\ifphysketch@angle@inner

% Options of the object commands (\pulley, \lightsource, \lens): the
% known keys of a family are processed, all other keys are collected in
% \physketch@opts and passed to TikZ.
\def\physketch@opts{}
\def\physketch@unknown#1{%
  \def\physketch@val{#1}%
  \ifx\physketch@val\pgfkeysnovalue@text
    \edef\physketch@opts{\unexpanded\expandafter{\physketch@opts},%
      \unexpanded\expandafter{\pgfkeyscurrentname}}%
  \else
    \edef\physketch@opts{\unexpanded\expandafter{\physketch@opts},%
      \unexpanded\expandafter{\pgfkeyscurrentname}={\unexpanded{#1}}}%
  \fi
}
% \physketch@getname{<family>}: the name of an object, or a scratch name
\def\physketch@getname#1{%
  \pgfkeysgetvalue{/physketch/#1/name}\physketch@name
  \ifx\physketch@name\@empty\def\physketch@name{physketch@scratch}\fi
}

